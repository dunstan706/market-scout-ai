[TEMPLATE]
# theBizScope — environment variables
#
# This file documents every env var the app reads. Copy to .env.local (or set
# in Lovable's secrets panel) and fill in real values. NEVER commit real keys.

# --- Supabase (provided by Lovable Cloud) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Lovable ---
LOVABLE_API_KEY=
LOVABLE_CRON_SECRET=
LOVABLE_SEND_URL=

# --- Paddle (merchant of record / checkout) ---
# sandbox or live. Live requires Paddle website approval first — checkout
# fails on the live account until thebizscope.com is approved under
# Checkout > Website approval.
PADDLE_ENV=sandbox
# Server-side API key (Dashboard > Developer tools > API keys). Use a
# sandbox key while PADDLE_ENV=sandbox, a live key once set to live.
PADDLE_API_KEY=
# Client-side token for Paddle.js overlay checkout. Live tokens are
# prefixed live_; sandbox tokens are not.
PADDLE_CLIENT_TOKEN=
# Webhook notification signing secret (Developer tools > Notifications).
# The live account needs its own notification destination with its own
# secret — secrets are not shared between sandbox and live.
PADDLE_WEBHOOK_SECRET=
# Catalog price IDs for the ACTIVE environment (live IDs differ from
# sandbox IDs — swap these when going live).
PADDLE_PRICE_WATCH_MONTHLY=
PADDLE_PRICE_WATCH_YEARLY=
PADDLE_PRICE_ADVISE_MONTHLY=
PADDLE_PRICE_ADVISE_YEARLY=

# --- Market research APIs ---
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
OVERTURE_API_KEY=
FOURSQUARE_CLIENT_ID=
FOURSQUARE_CLIENT_SECRET=
FOURSQUARE_SERVICE_API=
GEOAPIFY_API_KEY=

# --- Email (weekly briefs + market alerts) ---
RESEND_API_KEY=
# Sender address, e.g. "theBizScope <briefs@thebizscope.com>"
RESEND_FROM=

# --- App config ---
# Public site origin, used to build affiliate referral links
SITE_ORIGIN=https://thebizscope.com

# --- Affiliate program ---
# Comma-separated list of admin emails — these accounts see the payout
# console at /admin/affiliates. Leave empty to disable admin access.
ADMIN_EMAILS=
