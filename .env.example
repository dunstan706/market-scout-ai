[TEMPLATE]
# Copy to .env and fill in. Never commit the real .env (it is gitignored).

# --- Supabase (project dashboard → Project Settings → API) ---
# Public project URL, safe to expose.
SUPABASE_URL=https://your-project.supabase.co
# Publishable (anon) key — safe for the browser.
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Same values with the VITE_ prefix so Vite exposes them to the client bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Project id used by the local Supabase CLI (also in supabase/config.toml).
SUPABASE_PROJECT_ID=gosbzrvxqwstzyhscufs
VITE_SUPABASE_PROJECT_ID=gosbzrvxqwstzyhscufs
# Service-role (secret) key — server-side only, NEVER exposed to the client.
# Required for the waitlist form (admin inserts) and any admin operations.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Google Places (optional but recommended) ---
# Enables the Google Places (New) competitor directory + Google geocoding
# fallback in the live sample-brief generator. Get one at Google Cloud Console,
# enable "Places API (New)" and "Geocoding API", then restrict the key.
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# --- Lovable AI gateway (optional) ---
# Enables AI-written briefs via the Lovable gateway (gemini-3.7-flash).
# Without it the generator falls back to a deterministic evidence brief.
# Get it from Lovable Cloud → the connected project's settings.
LOVABLE_API_KEY=your_lovable_api_key

# --- Weekly email delivery (optional until you schedule the cron) ---
# Bearer secret your scheduler sends to POST /api/cron/run-monitoring.
LOVABLE_CRON_SECRET=your_long_random_secret
# Resend API key + verified sender for brief emails (https://resend.com).
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=theBizScope <support@thebizscope.com>

# --- Watch-tier research sources (optional; Lovable Cloud Secrets) ---
# See SETUP.md "Research sources" for what each key unlocks.
FOURSQUARE_SERVICE_API=your_foursquare_service_api_key
FOURSQUARE_CLIENT_ID=your_foursquare_client_id
FOURSQUARE_CLIENT_SECRET=your_foursquare_client_secret
GEOAPIFY_API_KEY=your_geoapify_api_key
OVERTURE_API_KEY=your_overture_api_key

# --- Paddle billing (merchant of record; sandbox for testing) ---
# Sandbox or live API is selected by PADDLE_ENV (sandbox default).
PADDLE_ENV=sandbox
# Paddle API key - Dashboard: Developer tools > Authentication > API keys.
PADDLE_API_KEY=your_paddle_api_key
# Webhook signing secret (Developer tools > Notifications > add https://<your-app>/api/webhooks/paddle).
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret
# Client-side token for Paddle.js checkout overlays (Developer tools > Authentication > Client-side tokens).
PADDLE_CLIENT_TOKEN=your_paddle_client_token
# Optional catalog price IDs (skip to use inline pricing).
# PADDLE_PRICE_WATCH_MONTHLY=pri_...
# PADDLE_PRICE_WATCH_YEARLY=pri_...
# PADDLE_PRICE_ADVISE_MONTHLY=pri_...
# PADDLE_PRICE_ADVISE_YEARLY=pri_...
